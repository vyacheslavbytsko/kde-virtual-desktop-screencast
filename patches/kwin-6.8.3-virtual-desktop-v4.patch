+WindowScreenCastSource::WindowScreenCastSource(VirtualDesktop *desktop, LogicalOutput *output)
+    : ScreenCastSource()
+    , m_desktopPanel(std::make_unique<ImageItem>())
+    , m_desktopCapture(true)
+    , m_desktop(desktop)
+    , m_output(output)
+    , m_desktopViewport(output->geometryF())
+    , m_desktopScale(output->scale())
+    , m_desktopRefreshRate(output->refreshRate())
+{
+    m_desktopUpdate.setSingleShot(true);
+    connect(&m_desktopUpdate, &QTimer::timeout, this, &WindowScreenCastSource::refreshDesktopWindows);
+    connect(workspace(), &Workspace::windowAdded, this, &WindowScreenCastSource::trackDesktopWindow);
+    connect(workspace(), &Workspace::stackingOrderChanged, this, [this] {
+        if (m_active) {
+            m_desktopUpdate.start();
+        }
+    });
+    for (Window *window : workspace()->windows()) {
+        trackDesktopWindow(window);
+    }
+
+    connect(workspace(), &Workspace::currentDesktopChanged, this, &WindowScreenCastSource::frame);
+    connect(Cursors::self(), &Cursors::hiddenChanged, this, &WindowScreenCastSource::frame);
+    connect(Cursors::self(), &Cursors::currentCursorChanged, this, &WindowScreenCastSource::frame);
+    connect(workspace(), &Workspace::currentActivityChanged, this, &WindowScreenCastSource::closed);
+    connect(VirtualDesktopManager::self(), &VirtualDesktopManager::desktopRemoved, this, [this](VirtualDesktop *removed) {
+        if (removed == m_desktop) {
+            m_desktop = nullptr;
+            Q_EMIT closed();
+        }
+    });
+    connect(workspace(), &Workspace::outputRemoved, this, [this](LogicalOutput *removed) {
+        if (removed == m_output) {
+            m_output = nullptr;
+            Q_EMIT closed();
+        }
+    });
+    connect(output, &LogicalOutput::changed, this, &WindowScreenCastSource::closed);
+    connect(waylandServer(), &WaylandServer::lockStateChanged, this, &WindowScreenCastSource::closed);
+}
+
+Window *WindowScreenCastSource::desktopSurface() const
+{
+    return m_desktop && m_output && !waylandServer()->isScreenLocked()
+        ? workspace()->findDesktop(m_desktop, m_output)
+        : nullptr;
+}
+
+bool WindowScreenCastSource::isDesktopTask(Window *window) const
+{
+    return m_desktop && m_output && !waylandServer()->isScreenLocked()
+        && window->readyForPainting() && !window->isDeleted() && !window->isHidden()
+        && window->isOnDesktop(m_desktop) && !window->isOnAllDesktops()
+        && window->isOnCurrentActivity() && window->isOnOutput(m_output)
+        && !window->excludeFromCapture() && !window->isInternal()
+        && (window->isNormalWindow() || window->isDialog());
+}
+
+bool WindowScreenCastSource::includesDesktopWindow(Window *window, Window *background) const
+{
+    if (window == background) {
+        return window->readyForPainting() && window->isOnCurrentActivity()
+            && !window->excludeFromCapture() && !window->isInternal();
+    }
+    return !window->isMinimized() && isDesktopTask(window);
+}
+
+void WindowScreenCastSource::trackDesktopWindow(Window *window)
+{
+    const auto scheduleUpdate = [this, window] {
+        if (m_active && (m_windows.contains(window) || m_desktopTasks.contains(window)
+                         || isDesktopTask(window) || window == desktopSurface())) {
+            m_desktopUpdate.start();
+        }
+    };
+    connect(window, &Window::readyForPaintingChanged, this, scheduleUpdate);
+    connect(window, &Window::desktopsChanged, this, scheduleUpdate);
+    connect(window, &Window::activitiesChanged, this, scheduleUpdate);
+    connect(window, &Window::frameGeometryChanged, this, scheduleUpdate);
+    connect(window, &Window::outputChanged, this, scheduleUpdate);
+    connect(window, &Window::minimizedChanged, this, scheduleUpdate);
+    connect(window, &Window::hiddenChanged, this, scheduleUpdate);
+    connect(window, &Window::excludeFromCaptureChanged, this, scheduleUpdate);
+    connect(window, &Window::opacityChanged, this, scheduleUpdate);
+    connect(window, &Window::iconChanged, this, scheduleUpdate);
+    connect(window, &Window::closed, this, [this, window] {
+        const bool removedTask = m_desktopTasks.removeOne(window);
+        const bool removedWindow = m_windows.removeOne(window);
+        if (removedWindow) {
+            unwatch(window);
+        }
+        if (removedTask || removedWindow) {
+            m_desktopUpdate.start();
+        }
+    });
+    scheduleUpdate();
+}
+
+void WindowScreenCastSource::refreshDesktopWindows()
+{
+    if (!m_active) {
+        return;
+    }
+
+    Window *const background = desktopSurface();
+    QList<Window *> windows;
+    for (Window *window : workspace()->stackingOrder()) {
+        if (includesDesktopWindow(window, background)) {
+            windows.append(window);
+        }
+    }
+
+    for (Window *window : std::as_const(m_windows)) {
+        if (!windows.contains(window)) {
+            unwatch(window);
+        }
+    }
+    for (Window *window : std::as_const(windows)) {
+        if (!m_windows.contains(window)) {
+            watch(window);
+        }
+    }
+    m_windows = std::move(windows);
+    m_desktopTasks.clear();
+    for (Window *window : workspace()->windows()) {
+        if (isDesktopTask(window)) {
+            m_desktopTasks.append(window);
+        }
+    }
+    Q_EMIT frame();
+}
+
+void WindowScreenCastSource::updateDesktopPanel()
+{
+    constexpr int margin = 8;
+    constexpr int tile = 40;
+    constexpr int inset = 6;
+    constexpr int height = tile + 2 * inset;
+    const int capacity = (qFloor(m_desktopViewport.width()) - 2 * (margin + inset)) / tile;
+    QList<QIcon> icons;
+    QList<qint64> keys;
+    if (capacity > 0) {
+        for (Window *window : std::as_const(m_desktopTasks)) {
+            if (isDesktopTask(window)) {
+                icons.append(window->icon());
+                keys.append(window->icon().cacheKey());
+            }
+        }
+    }
+    if (keys == m_panelIconKeys) {
+        return;
+    }
+    m_panelIconKeys = std::move(keys);
+    if (icons.isEmpty()) {
+        m_desktopPanel->setImage(QImage());
+        m_desktopPanel->setSize(QSizeF(0, 0));
+        return;
+    }
+
+    const int slots = std::min(capacity, int(icons.size()));
+    const bool overflow = icons.size() > slots;
+    const int visibleIcons = overflow ? slots - 1 : slots;
+    const int width = slots * tile + 2 * inset;
+    QImage image((QSizeF(width, height) * m_desktopScale).toSize(), QImage::Format_ARGB32_Premultiplied);
+    if (image.isNull()) {
+        m_desktopPanel->setImage(QImage());
+        m_desktopPanel->setSize(QSizeF(0, 0));
+        m_panelIconKeys.clear();
+        return;
+    }
+    image.setDevicePixelRatio(m_desktopScale);
+    image.fill(Qt::transparent);
+
+    QPainter painter(&image);
+    painter.setRenderHint(QPainter::Antialiasing);
+    painter.setPen(Qt::NoPen);
+    painter.setBrush(QColor(32, 35, 43, 242));
+    painter.drawRoundedRect(QRectF(0, 0, width, height), 12, 12);
+    const QIcon fallback = QIcon::fromTheme(QStringLiteral("application-x-executable"));
+    for (int index = 0; index < visibleIcons; ++index) {
+        const QRect iconRect(inset + index * tile + 7, inset + 7, 26, 26);
+        const QIcon &icon = icons[index].isNull() ? fallback : icons[index];
+        if (icon.isNull()) {
+            painter.setBrush(QColor(224, 227, 233));
+            painter.drawRoundedRect(iconRect.adjusted(4, 6, -4, -6), 3, 3);
+        } else {
+            icon.paint(&painter, iconRect);
+        }
+    }
+    if (overflow) {
+        painter.setPen(Qt::white);
+        painter.drawText(QRect(inset + visibleIcons * tile, inset, tile, tile),
+                         Qt::AlignCenter, QStringLiteral("+%1").arg(icons.size() - visibleIcons));
+    }
+    painter.end();
+
+    m_desktopPanel->setPosition(QPointF(m_desktopViewport.x() + (m_desktopViewport.width() - width) / 2,
+                                         m_desktopViewport.y() + m_desktopViewport.height() - height - margin));
+    m_desktopPanel->setSize(QSizeF(width, height));
+    m_desktopPanel->setImage(image);
+}
