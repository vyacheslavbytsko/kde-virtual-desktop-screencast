+void ScreencastManager::streamVirtualDesktop(ScreencastStreamV1Interface *waylandStream, const QString &desktopId, OutputInterface *output, ScreencastV1Interface::CursorMode mode)
+{
+    auto desktop = VirtualDesktopManager::self()->desktopForId(desktopId);
+    if (!desktop || !output || output->isRemoved() || !output->handle()
+        || !isSupportedCompositingType() || waylandServer()->isScreenLocked()) {
+        waylandStream->sendFailed(i18n("Could not capture the requested virtual desktop"));
+        return;
+    }
+
+    auto stream = new ScreenCastStream(new WindowScreenCastSource(desktop, output->handle()), getPipewireConnection(), this);
+    stream->setObjectName(desktopId);
+    switch (mode) {
+    case ScreencastV1Interface::Embedded:
+    case ScreencastV1Interface::Metadata:
+        stream->setCursorMode(mode);
+        break;
+    default:
+        stream->setCursorMode(ScreencastV1Interface::Hidden);
+        break;
+    }
     integrateStreams(waylandStream, stream);
 }
 
