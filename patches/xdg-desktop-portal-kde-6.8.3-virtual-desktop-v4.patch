 Screencasting::~Screencasting() = default;
+
+bool Screencasting::supportsVirtualDesktop() const
+{
+    return d && zkde_screencast_unstable_v1_get_version(d->object()) >= ZKDE_SCREENCAST_UNSTABLE_V1_STREAM_VIRTUAL_DESKTOP_SINCE_VERSION;
+}
+
+ScreencastingStream *Screencasting::createVirtualDesktopStream(const QString &desktopId, QScreen *screen, CursorMode mode)
+{
+    if (!supportsVirtualDesktop() || !screen) {
+        return nullptr;
+    }
+
+    auto native = qGuiApp->platformNativeInterface();
+    auto *output = reinterpret_cast<wl_output *>(native->nativeResourceForScreen(QByteArrayLiteral("output"), screen));
+    if (!output) {
+        return nullptr;
+    }
+
+    auto stream = new ScreencastingStream(this);
+    if (zkde_screencast_unstable_v1_get_version(d->object()) >= ZKDE_SCREENCAST_UNSTABLE_V1_STREAM_VIRTUAL_DESKTOP_WITH_CURSOR_SINCE_VERSION) {
+        stream->d->init(d->stream_virtual_desktop_with_cursor(desktopId, output, mode));
+    } else {
+        stream->d->init(d->stream_virtual_desktop(desktopId, output));
+    }
+    stream->d->m_geometry = screen->geometry();
+    stream->d->metaData = {
+        {u"size"_s, screen->size()},
+        {u"source_type"_s, static_cast<uint>(ScreenCastPortal::Monitor)},
+    };
+    return stream;
+}
 
